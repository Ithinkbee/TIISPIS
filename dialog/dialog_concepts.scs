/* Файл создан gen_dialog.py. Классы сообщений, добавленные в ЛР 3,
   и идентификаторы правил ответа и классов фраз. */

concept_message_about_reign_years
<- sc_node_class;
=> nrel_main_idtf:
    [сообщение о годах правления]
    (* <- lang_ru;; *);
<= nrel_inclusion: concept_atomic_message;
<- rrel_key_sc_element:
    ...
    (*
    => nrel_main_idtf:
        [Опр. (сообщение о годах правления)]
        (* <- lang_ru;; *);;
    <- definition;;
    <= nrel_sc_text_translation:
        ...
        (*
        -> rrel_example:
            [Сообщение о годах правления - атомарное сообщение, в котором спрашивается, когда правил указанный правитель Древнего Рима.]
            (* <- lang_ru;; *);;
        *);;
    <= nrel_using_constants: {
        concept_atomic_message;
        rrel_entity
    };;
    *);;


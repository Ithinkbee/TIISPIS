concept_ancient_roman_person
<- sc_node_class;
<- class;
=> nrel_main_idtf:
    [лицо Древнего Рима]
    (* <- lang_ru;; *);
=> nrel_note:
    [Человек, чья деятельность связана с Древним Римом, от эпохи Римского царства до падения Западной Римской
     империи. Включает как исторических, так и легендарных лиц]
    (* <- lang_ru;; *);;

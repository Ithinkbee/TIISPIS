concept_legendary_person
<- sc_node_class;
<- class;
=> nrel_main_idtf:
    [легендарное лицо]
    (* <- lang_ru;; *);
<= nrel_inclusion:
    concept_ancient_roman_person;
=> nrel_note:
    [Лицо, известное по преданию, историчность которого не подтверждена источниками. В римской традиции к
     таким лицам относят основателя города и первых царей]
    (* <- lang_ru;; *);;

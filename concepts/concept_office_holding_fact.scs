concept_office_holding_fact
<- sc_node_class;
<- class;
=> nrel_main_idtf:
    [факт нахождения в должности]
    (* <- lang_ru;; *);
=> nrel_note:
    [Класс связок, каждая из которых описывает пребывание конкретного лица в конкретной государственной
    должности в конкретные годы. Связка небинарна: её компоненты различаются ролевыми отношениями,
    поскольку одно лицо могло занимать одну и ту же должность неоднократно]
    (* <- lang_ru;; *);;

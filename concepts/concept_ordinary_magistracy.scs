concept_ordinary_magistracy
<- sc_node_class;
<- class;
=> nrel_main_idtf:
    [ординарная магистратура]
    (* <- lang_ru;; *);
<= nrel_inclusion:
    concept_roman_magistracy;
=> nrel_note:
    [Магистратура, замещаемая регулярно, в обычном порядке выборов на народном собрании. К ординарным
     относятся консулат, претура, цензура, эдилитет, квестура и народный трибунат]
    (* <- lang_ru;; *);;

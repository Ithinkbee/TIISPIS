concept_roman_legion
<- sc_node_class;
<- class;
=> nrel_main_idtf:
    [римский легион]
    (* <- lang_ru;; *);
<= nrel_inclusion:
    concept_roman_military_unit;
=> nrel_note:
    [Основное соединение римской армии. В имперский период состоял из десяти когорт и насчитывал около 5280
     человек. В республиканский период численность колебалась от 3000 до 4200 человек]
    (* <- lang_ru;; *);;

concept_roman_emperor
<- sc_node_class;
<- class;
=> nrel_main_idtf:
    [римский император]
    (* <- lang_ru;; *);
<= nrel_inclusion:
    concept_roman_ruler;
=> nrel_note:
    [Верховный правитель Римской империи. Власть императора опиралась на совокупность полномочий, формально
     предоставляемых сенатом, прежде всего на проконсульский империй и трибунскую власть]
    (* <- lang_ru;; *);;

roman_senate
<- concept_roman_state_body;
=> nrel_main_idtf: [римский сенат] (* <- lang_ru;; *);
=> nrel_note: [Совет, состоявший из бывших магистратов. Список сената составляли цензоры. В республиканский период сенат определял внешнюю политику и распоряжался казной] (* <- lang_ru;; *);;

centuriate_assembly
<- concept_roman_popular_assembly;
=> nrel_main_idtf: [центуриатные комиции] (* <- lang_ru;; *);
=> nrel_note: [Народное собрание, голосовавшее по центуриям, распределённым по имущественным разрядам. Избирало консулов, преторов и цензоров. Устройство приписывается реформе Сервия Туллия] (* <- lang_ru;; *);;

tribal_assembly
<- concept_roman_popular_assembly;
=> nrel_main_idtf: [трибутные комиции] (* <- lang_ru;; *);
=> nrel_note: [Народное собрание, голосовавшее по территориальным трибам. Избирало квесторов, эдилов и народных трибунов] (* <- lang_ru;; *);;

curiate_assembly
<- concept_roman_popular_assembly;
=> nrel_main_idtf: [куриатные комиции] (* <- lang_ru;; *);
=> nrel_note: [Древнейшее народное собрание, голосовавшее по куриям. К республиканскому времени сохранило преимущественно обрядовое значение] (* <- lang_ru;; *);;

constitutio_antoniniana
<- concept_roman_law;
=> nrel_main_idtf: [Эдикт Каракаллы] (* <- lang_ru;; *);
=> nrel_establishment_year: year_212_ad;
=> nrel_note: [Эдикт 212 года н. э., предоставивший римское гражданство всем свободным жителям империи и упразднивший тем самым различие между гражданами и перегринами] (* <- lang_ru;; *);;

lex_villia_annalis
<- concept_roman_law;
=> nrel_main_idtf: [закон Виллия о возрасте] (* <- lang_ru;; *);
=> nrel_establishment_year: year_180_bc;
=> nrel_note: [Закон 180 года до н. э., впервые установивший минимальный возраст для занятия магистратур и обязательные промежутки между ними] (* <- lang_ru;; *);;

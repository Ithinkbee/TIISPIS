=> nrel_note: [Пятый и последний император династии Юлиев-Клавдиев. Династия пресеклась с его смертью 9 июня 68 года] (* <- lang_ru;; *);;

julio_claudian_dynasty
<- concept_roman_dynasty;
=> nrel_main_idtf: [династия Юлиев-Клавдиев] (* <- lang_ru;; *);
=> nrel_note: [Первая династия римских императоров, правившая с 27 года до н. э. по 68 год н. э] (* <- lang_ru;; *);;

divus_augustus <- concept_roman_deity;
=> nrel_main_idtf: [Божественный Август] (* <- lang_ru;; *);;
divus_claudius <- concept_roman_deity;
=> nrel_main_idtf: [Божественный Клавдий] (* <- lang_ru;; *);;

gaius_julius_caesar
<- concept_roman_magistrate;
<- concept_roman_military_commander;
=> nrel_main_idtf: [Гай Юлий Цезарь] (* <- lang_ru;; *);
=> nrel_period_membership: roman_republic;
=> nrel_social_stratum_membership: patricians;
=> nrel_magistracy_holding: consulate;
=> nrel_magistracy_holding: dictatorship;
=> nrel_note: [Римский государственный деятель и полководец, консул 59 года до н. э., впоследствии пожизненный диктатор] (* <- lang_ru;; *);;

marcus_licinius_crassus
<- concept_roman_magistrate;
<- concept_roman_military_commander;
=> nrel_main_idtf: [Марк Лициний Красс] (* <- lang_ru;; *);
=> nrel_period_membership: roman_republic;
=> nrel_magistracy_holding: consulate;
=> nrel_note: [Римский полководец и богатейший человек Рима, подавивший восстание Спартака. Консул 70 и 55 годов до н. э] (* <- lang_ru;; *);;

spartacus
<- concept_gladiator;
=> nrel_main_idtf: [Спартак] (* <- lang_ru;; *);
=> nrel_period_membership: roman_republic;
=> nrel_origin: thracians;
=> nrel_social_stratum_membership: slaves;
=> nrel_defeated_by: marcus_licinius_crassus;
=> nrel_note:
    [Фракиец, родившийся около 103 года до н. э. в окрестностях реки Стримон. Раб и гладиатор-мурмиллон
    школы Лентула Батиата в Капуе. В 73 году до н. э. вместе примерно с семьюдесятью гладиаторами бежал
    из школы и возглавил Третью Сервильную войну. Погиб в 71 году до н. э]
    (* <- lang_ru;; *);;

third_servile_war
<- concept_roman_armed_conflict;
=> nrel_main_idtf: [Третья Сервильная война] (* <- lang_ru;; *);
=> nrel_conflict_years: interval_73_71_bc;
=> nrel_conflict_leader: spartacus;
=> nrel_note: [Крупнейшее восстание рабов против Римской республики, продолжавшееся с 73 по 71 год до н. э] (* <- lang_ru;; *);;

/* ЛР2: примечания */

claudius
=> nrel_note:
    [Четвёртый император династии Юлиев-Клавдиев, правивший в 41-54 годах н. э. После смерти был обожествлён]
    (* <- lang_ru;; *);;

divus_augustus
=> nrel_note:
    [Август, обожествлённый решением сената после смерти в 14 году н. э]
    (* <- lang_ru;; *);;

divus_claudius
=> nrel_note:
    [Клавдий, обожествлённый после смерти в 54 году н. э]
    (* <- lang_ru;; *);;

tiberius
=> nrel_note:
    [Второй император династии Юлиев-Клавдиев, правивший в 14-37 годах н. э. Пасынок и приёмный сын Августа]
    (* <- lang_ru;; *);;

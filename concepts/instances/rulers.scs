=> nrel_ordinal_in_dynasty: number_4;
=> nrel_ruler_predecessor: caligula;
=> nrel_deification: divus_claudius;;

nero
<- concept_roman_emperor;
=> nrel_main_idtf: [Нерон] (* <- lang_ru;; *);
=> nrel_idtf: [Нерон Клавдий Цезарь Август Германик] (* <- lang_ru;; *);

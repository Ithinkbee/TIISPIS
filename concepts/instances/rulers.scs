romulus
<- concept_roman_king;
<- concept_legendary_person;
=> nrel_main_idtf: [Ромул] (* <- lang_ru;; *);
=> nrel_reign_years: interval_753_716_bc;
=> nrel_period_membership: roman_kingdom;
=> nrel_origin: latins;
=> nrel_deification: quirinus;
=> nrel_note:
    [Легендарный основатель Рима и первый римский царь. Историчность не подтверждена источниками.
    По преданию, после смерти был обожествлён под именем Квирина]
    (* <- lang_ru;; *);;

numa_pompilius
<- concept_roman_king;
<- concept_legendary_person;
=> nrel_main_idtf: [Нума Помпилий] (* <- lang_ru;; *);
=> nrel_reign_years: interval_715_672_bc;
=> nrel_period_membership: roman_kingdom;
=> nrel_origin: sabines;
=> nrel_ruler_predecessor: romulus;
=> nrel_note: [Второй римский царь, которому традиция приписывает учреждение жреческих коллегий и календаря] (* <- lang_ru;; *);;

tarquinius_priscus
<- concept_roman_king;
=> nrel_main_idtf: [Луций Тарквиний Приск] (* <- lang_ru;; *);
=> nrel_reign_years: interval_616_578_bc;
=> nrel_period_membership: roman_kingdom;
=> nrel_origin: etruscans;
=> nrel_note: [Пятый римский царь, первый из царей этрусского происхождения] (* <- lang_ru;; *);;

servius_tullius
<- concept_roman_king;
=> nrel_main_idtf: [Сервий Туллий] (* <- lang_ru;; *);
=> nrel_reign_years: interval_578_534_bc;
=> nrel_period_membership: roman_kingdom;
=> nrel_ruler_predecessor: tarquinius_priscus;
=> nrel_note:
    [Шестой римский царь. Традиция приписывает ему центуриатную реформу, разделившую граждан
    на имущественные разряды и определившую устройство центуриатных комиций]
    (* <- lang_ru;; *);;

tarquinius_superbus
<- concept_roman_king;
=> nrel_main_idtf: [Луций Тарквиний Гордый] (* <- lang_ru;; *);
=> nrel_reign_years: interval_534_509_bc;
=> nrel_period_membership: roman_kingdom;
=> nrel_origin: etruscans;
=> nrel_ruler_predecessor: servius_tullius;
=> nrel_note: [Седьмой и последний римский царь. Его изгнание в 509 году до н. э. положило конец царскому периоду] (* <- lang_ru;; *);;

augustus
<- concept_roman_emperor;
=> nrel_main_idtf: [Октавиан Август] (* <- lang_ru;; *);
=> nrel_reign_years: interval_27_bc_14_ad;
=> nrel_period_membership: roman_empire;
=> nrel_dynasty_membership: julio_claudian_dynasty;
=> nrel_ordinal_in_dynasty: number_1;
=> nrel_deification: divus_augustus;
=> nrel_note: [Первый римский император, основатель принципата. Династия Юлиев-Клавдиев отсчитывается с 16 января 27 года до н. э] (* <- lang_ru;; *);;

tiberius
<- concept_roman_emperor;
=> nrel_main_idtf: [Тиберий] (* <- lang_ru;; *);
=> nrel_reign_years: interval_14_37_ad;
=> nrel_period_membership: roman_empire;
=> nrel_dynasty_membership: julio_claudian_dynasty;
=> nrel_ordinal_in_dynasty: number_2;
=> nrel_ruler_predecessor: augustus;;

caligula
<- concept_roman_emperor;
=> nrel_main_idtf: [Калигула] (* <- lang_ru;; *);
=> nrel_idtf: [Гай Юлий Цезарь Август Германик] (* <- lang_ru;; *);

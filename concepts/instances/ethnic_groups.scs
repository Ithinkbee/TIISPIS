latins <- concept_ethnic_group;
=> nrel_main_idtf: [латиняне] (* <- lang_ru;; *);;
sabines <- concept_ethnic_group;
=> nrel_main_idtf: [сабиняне] (* <- lang_ru;; *);;
etruscans <- concept_ethnic_group;
=> nrel_main_idtf: [этруски] (* <- lang_ru;; *);;
thracians <- concept_ethnic_group;
=> nrel_main_idtf: [фракийцы] (* <- lang_ru;; *);;

/* ЛР2: примечания */

etruscans
=> nrel_note:
    [Народ, населявший Этрурию к северу от Рима. Из этрусков происходили последние римские цари - Тарквиний Приск и Тарквиний Гордый]
    (* <- lang_ru;; *);;

latins
=> nrel_note:
    [Италийский народ, населявший область Лаций. Римляне сами принадлежали к латинянам]
    (* <- lang_ru;; *);;

sabines
=> nrel_note:
    [Италийский народ, живший к северо-востоку от Рима. По преданию, часть сабинян вошла в римскую общину ещё при Ромуле, а сабинянином был царь Нума Помпилий]
    (* <- lang_ru;; *);;

thracians
=> nrel_note:
    [Группа индоевропейских племён, населявших восток Балканского полуострова. Фракийцем был Спартак]
    (* <- lang_ru;; *);;

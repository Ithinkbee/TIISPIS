imperium
<- concept_type_of_roman_power;
=> nrel_main_idtf: [империй] (* <- lang_ru;; *);
=> nrel_note: [Высшая военная и судебная власть, дававшая право командовать войском и выносить смертные приговоры. Обладателя империя сопровождали ликторы] (* <- lang_ru;; *);;

potestas
<- concept_type_of_roman_power;
=> nrel_main_idtf: [потестас] (* <- lang_ru;; *);
=> nrel_note: [Обычная должностная власть, не включавшая права высшего военного командования] (* <- lang_ru;; *);;

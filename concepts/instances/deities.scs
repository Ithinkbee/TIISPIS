quirinus
<- concept_roman_deity;
=> nrel_main_idtf: [Квирин] (* <- lang_ru;; *);
=> nrel_note:
    [Божество италийского, вероятно сабинского происхождения, изначально почитавшееся как бог войны.
    Алтарь сабинян стоял на Квиринальском холме. Входил в древнейшую триаду вместе с Юпитером и Марсом,
    позднее вытесненную триадой Юпитера, Юноны и Минервы. Ко II веку до н. э. отождествлён с
    обожествлённым Ромулом; праздник Квириналии отмечался 17 февраля, в традиционный день смерти Ромула]
    (* <- lang_ru;; *);;

jupiter
<- concept_roman_deity;
=> nrel_main_idtf: [Юпитер] (* <- lang_ru;; *);
=> nrel_note: [Верховное божество римского пантеона, глава как древнейшей, так и капитолийской триады] (* <- lang_ru;; *);;

mars
<- concept_roman_deity;
=> nrel_main_idtf: [Марс] (* <- lang_ru;; *);
=> nrel_note: [Бог войны, входивший в древнейшую римскую триаду вместе с Юпитером и Квирином] (* <- lang_ru;; *);;
